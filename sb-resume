#!/bin/bash
# usage: sb-resume <path>
# restart a previously stopped sandbox at <path>
set -e
SB="$(realpath -m "${1:?usage: $0 <path>}")"
NAME="$(basename "$SB")"
MACHINE="${NAME//_/-}"
MERGED="/tmp/sb-merged-$MACHINE"

if [[ ! -d "$SB/upper" ]]; then
  echo "sandbox '$SB' does not exist — use sb-create to make a new one" >&2
  exit 1
fi

if pgrep -f "systemd-nspawn.*--machine=$MACHINE" >/dev/null; then
  echo "sandbox '$NAME' is already running"
  exit 0
fi

sudo mkdir -p "$MERGED"
if ! mountpoint -q "$MERGED"; then
  sudo mount -t overlay overlay \
    -o lowerdir=/,upperdir="$SB/upper",workdir="$SB/work" \
    "$MERGED"
fi

sudo install -Dm644 /dev/stdin "$SB/upper/etc/profile.d/sb-prompt.sh" <<EOF
export SB_NAME='$NAME'
PROMPT_COMMAND='_c=\$([ \$EUID -eq 0 ] && echo 31 || echo 32); PS1="\[\033[1;33m\][sb:\[\033[1;36m\]\$SB_NAME\[\033[1;33m\]]\[\033[1;\${_c}m\] \u@\h\[\033[0m\]:\w\\\$ "'
EOF

INACCESSIBLE=()
if [[ "$(findmnt -no TARGET --target "$SB")" == "/" ]]; then
  INACCESSIBLE=(--inaccessible="$SB")
fi

sudo systemd-run --collect --unit="nspawn-$MACHINE" \
  systemd-nspawn \
    --boot \
    --directory="$MERGED" \
    --machine="$MACHINE" \
    --register=no \
    --link-journal=no \
    --resolv-conf=off \
    --bind-ro=/run/systemd/resolve \
    "${INACCESSIBLE[@]}"

sleep 2
echo "sandbox '$NAME' resumed ($SB)"
echo "  enter: sb-enter $SB"
